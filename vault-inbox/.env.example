# CouchDB that backs your Obsidian LiveSync vault. host.docker.internal is the
# Pi itself; use the CouchDB container's name instead if it shares a network.
COUCHDB_URL=http://host.docker.internal:5984
COUCHDB_USER=your_admin_user
COUCHDB_PASSWORD=your_secure_password
DB_NAME=obsidiannotes

# LiveSync end-to-end encryption passphrase (never stored in CouchDB)
E2EE_PASSPHRASE=your_e2ee_passphrase

# Vault ID key: plugin settings → "Show current recovery code" (sls-id-v1:...).
# Recent vaults with E2EE have one; without it Obsidian ignores bridged files.
LIVESYNC_ID_KEY=
# Same as the plugin's path obfuscation setting (true/false)
PATH_OBFUSCATION=true

# Vault folder the inbox mirrors (trailing slash)
VAULT_FOLDER=Kindle/

# WebDAV login the Kindle uploads with. Generate: openssl rand -hex 24
WEBDAV_USER=kindle
WEBDAV_PASS=change-me-to-a-long-random-string
WEBDAV_PORT=8080
