+/* Test hook: qom-set <stylus> pen "x y pressure [proximity [eraser]]". */
+static void wacom_set_pen(Object *obj, const char *value, Error **errp)
+{
+    unsigned x, y, pressure, proximity = 1, eraser = 0;
+    if (sscanf(value, "%u %u %u %u %u", &x, &y, &pressure, &proximity,
+               &eraser) < 3) {
+        error_setg(errp, "expected \"x y pressure [proximity [eraser]]\"");
+        return;
+    }
+    wacom_emr_set_input(DEVICE(obj), x, y, pressure, proximity, eraser);
+}
